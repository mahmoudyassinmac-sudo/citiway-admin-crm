# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by /api/cron/* to sign PDF URLs and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the n8n daily trigger: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Letters → AI Draft mode (server-side, model claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...
