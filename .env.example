# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used by /api/cron/* to sign PDF URLs and bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the n8n daily trigger: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Letters → AI Draft mode (server-side, model claude-sonnet-4-6)
ANTHROPIC_API_KEY=sk-ant-...

# Document issue alerts (confirmation & audit email to company_settings.admin_alert_email)
# Primary: Resend (https://resend.com). Without a verified domain, onboarding@resend.dev only
# delivers to your own Resend account email — verify a domain and set ALERT_FROM_EMAIL for real use.
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL=Citiway CRM <alerts@your-domain.com>
# Optional: also POST the full JSON payload to an n8n webhook (route to Gmail/SMTP, archive, etc.)
N8N_DOCUMENT_WEBHOOK_URL=
# Used for the "View in CRM" link in emails (falls back to the Vercel production URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
